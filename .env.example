# =========================================
#  متغيّرات البيئة — مكتب المحامي نواف بن أحمد المالكي
# =========================================
# انسخ هذا الملف إلى ".env.local" محليًا، أو أضف القيم في
# Vercel → Project Settings → Environment Variables.
# لا ترفع ملف .env.local إلى GitHub إطلاقًا (محمي في .gitignore).

# ---- Resend — مطلوب (المتغيّر الوحيد الإجباري) ----
# سجّل في https://resend.com واحصل على مفتاح يبدأ بـ re_
RESEND_API_KEY=ضع_المفتاح_هنا

# ---- اختياري — لها قيم افتراضية داخل الكود ----
# عنوان المُرسِل. يجب أن يكون على نطاق موثّق داخل Resend.
# الافتراضي: مكتب المالكي <noreply@law-2030.com>
# RESEND_FROM="مكتب المالكي <noreply@law-2030.com>"

# البريد الذي تصله رسائل النماذج. الافتراضي: nawaf@law-2030.com
# CONTACT_EMAIL=nawaf@law-2030.com

# ---- اختياري — حماية النماذج من السبام (Cloudflare Turnstile) ----
# إن تُركت فارغة، تعمل النماذج بشكل طبيعي بدون تحقّق Captcha.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
